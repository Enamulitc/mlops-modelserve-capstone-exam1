# ─────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mlflow

# ── MLflow ─────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=proddetection-model
# Production: point to S3
# MLFLOW_S3_BUCKET=s3://your-bucket/mlflow-artifacts

# ── Redis (Feast online store) ─────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Grafana ─────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ── AWS (used by Pulumi and GitHub Actions) ─────────
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_DEFAULT_REGION=ap-southeast-1

# ── ECR ──────────────────────────────────────────────
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
ECR_REPOSITORY=modelserve/proddetection

# ── Deployment target ────────────────────────────────
DEPLOY_HOST=          # EC2 public IP or Poridhi VM IP
DEPLOY_USER=ubuntu
